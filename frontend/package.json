{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "battlezones-frontend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "typecheck": "vue-tsc --build",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:generate": "openapi-typescript ../docs/openapi.yaml --output src/api/schema.d.ts",
        "types:check": "npm run types:generate && git diff --exit-code -- src/api/schema.d.ts",
        "check:secrets": "node scripts/check-bundle-secrets.mjs dist",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install --with-deps chromium"
    },
    "dependencies": {
        "@tanstack/vue-query": "^5.102.2",
        "pinia": "^4.0.3",
        "vue": "^3.5.41",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@pinia/testing": "^2.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.10.0",
        "jsdom": "^26.1.0",
        "openapi-typescript": "^7.13.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.6",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^3.2.7",
        "vue-tsc": "^3.3.11"
    }
}
